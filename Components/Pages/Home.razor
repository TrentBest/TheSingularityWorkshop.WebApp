@namespace TheSingularityWorkshop.WebApp.Components.Pages
@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject TheSingularityWorkshop.WebApp.Infrastructure.WebAppExperienceRuntime Experience
@inject TheSingularityWorkshop.WebApp.Infrastructure.WebAppCosRuntime CosRuntime
@inject Microsoft.JSInterop.IJSRuntime JS
@using TheSingularityWorkshop.Workshop.Gui

<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-root @(Experience.NavigationVisible ? "navigation-arrived" : "")">
    @if (!Experience.EnterRequested)
    {
        <section class="gateway" aria-label="The Singularity Workshop gateway">
            <div class="gateway-aura"></div>
            <div class="gateway-mark" aria-hidden="true">[0]</div>
            <p class="eyebrow">THE SINGULARITY WORKSHOP</p>
            <div class="gateway-moniker">
                <span>THE</span>
                <strong>SINGULARITY</strong>
                <span>WORKSHOP</span>
            </div>
            <p class="gateway-copy">
                A living software workshop. Independent pieces. Explicit meaning.
                Runtime composition.
            </p>
            <div class="gateway-warning">
                <span class="warning-icon">!</span>
                <div>
                    <strong>YOU ARE ABOUT TO ENTER A LIVE EXPERIENCE</strong>
                    <p>The interface is not a still page. Its inhabitants are driven independently by FSM_API.</p>
                </div>
            </div>
            <div class="gateway-actions">
                <button class="voice-intro-button" @onclick="HearWorkshop">▶ HEAR ABOUT THE WORKSHOP</button>
                <button class="voice-intro-stop" @onclick="StopWorkshopVoice">■ STOP VOICE</button>
            </div>
            <p class="voice-intro-status" role="status" aria-live="polite">@_voiceStatus</p>
            <button class="enter-button" @onclick="EnterWorkshop">
                ENTER WORKSHOP <span>↗</span>
            </button>
        </section>
    }
    else
    {
        <main class="experience-stage" aria-label="Living Workshop experience">
            <div class="stage-grid"></div>
            <div class="stage-aura"></div>

            @foreach (var actor in Experience.Actors)
            {
                if (!actor.Active)
                    continue;

                <div class="living-actor @(actor.IsRoot ? "root" : "") @(Experience.CurrentState == "Gravity" ? "gravity" : "")"
                     style="@ActorStyle(actor)"
                     aria-label="@actor.Lineage">
                    @actor.Lineage
                </div>
            }

            @if (Experience.MonikerVisible && !Experience.NavigationVisible)
            {
                <section class="experience-moniker" aria-label="The Singularity Workshop">
                    @if (CosRuntime.Moniker.Root is { } monikerRoot)
                    {
                        @BlazorGuiRenderer.Render(monikerRoot)
                    }
                </section>
            }

            @if (Experience.NavigationVisible)
            {
                <aside class="workshop-hub" aria-label="Workshop navigation">
                    <div class="hub-brand"><span>THE</span><strong>SINGULARITY</strong><span>WORKSHOP</span></div>
                    <nav>
                        <a href="#anyapp">ANYAPP</a>
                        <a href="/explore">EXPLORE</a>
                        <a href="#create">CREATE</a>
                        <a href="#rendering">RENDERING</a>
                    </nav>
                </aside>
            }

            <div class="experience-status">
                <span class="status-dot"></span>
                <span>@Experience.CurrentState</span>
                <span>POPULATION @Experience.Population / 100</span>
            </div>
        </main>
    }
</div>

@code {
    private string _voiceStatus = "Optional spoken introduction. Choose it when you're ready.";

    private async Task HearWorkshop()
    {
        try
        {
            var started = await JS.InvokeAsync<bool>("workshopVoice.speak", new object?[] { "Welcome to the Singularity Workshop. What you are entering is more than a conventional webpage. It is a living software experience, assembled from independent pieces with explicit meaning and runtime composition. The scene's inhabitants are driven by a finite state machine, so you can watch behavior unfold rather than only read about it. Explore the gateway, enter the Workshop, and follow your curiosity. When you are ready, visit the Exploratorium for playful introductions to cause and effect, motion, and discovery." });
            _voiceStatus = started ? "Speaking. You can stop the introduction at any time." : "Spoken narration is not supported here; the written introduction remains available.";
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _voiceStatus = "Voice introduction is unavailable right now.";
        }
    }

    private async Task StopWorkshopVoice()
    {
        try
        {
            var stopped = await JS.InvokeAsync<bool>("workshopVoice.stop", Array.Empty<object>());
            _voiceStatus = stopped ? "Voice stopped." : "Voice control is not supported here.";
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _voiceStatus = "Voice control is unavailable right now.";
        }
    }

    protected override void OnInitialized()
    {
        Experience.Changed += HandleChanged;
    }

    private void EnterWorkshop() => Experience.RequestEnter();

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private static string ActorStyle(TheSingularityWorkshop.WebApp.Infrastructure.WebAppExperienceRuntime.ActorContext actor)
    {
        var color = actor.IsRoot ? "#ff7a00" : Palette[Math.Abs(actor.Lineage.GetHashCode()) % Palette.Length];
        var opacity = actor.Y <= 100 ? 1 : Math.Clamp(1 - ((actor.Y - 100) / 30), 0, 1);
        return $"left:{actor.X:0.###}%;top:{actor.Y:0.###}%;width:{actor.Size:0.##}px;height:{actor.Size:0.##}px;opacity:{opacity:0.###};transform:translate(-50%,-50%) rotate({actor.Rotation:0.##}deg);--flower-color:{color};";
    }

    private static readonly string[] Palette =
    {
        "#ff3030", "#ff7a00", "#ffd34d", "#52e05a", "#00a8ff", "#ff2cff"
    };

    public void Dispose()
    {
        Experience.Changed -= HandleChanged;
        _ = StopWorkshopVoiceOnDispose();
    }

    private async Task StopWorkshopVoiceOnDispose()
    {
        try { await JS.InvokeVoidAsync("workshopVoice.stop"); }
        catch (Microsoft.JSInterop.JSException) { }
    }
}
