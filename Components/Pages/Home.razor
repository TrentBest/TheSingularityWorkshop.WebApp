@namespace TheSingularityWorkshop.WebApp.Components.Pages
@page "/"

@using TheSingularityWorkshop.Workshop.Gui
@using TheSingularityWorkshop.WebApp.Infrastructure
@inject WebAppCosRuntime Runtime

<PageTitle>The Singularity Workshop</PageTitle>

<header class="site-header">
    <a class="brand" href="/" aria-label="The Singularity Workshop home">
        <span>The</span>
        <strong>Singularity</strong>
        <span>Workshop</span>
    </a>
    <nav aria-label="Primary navigation">
        <a href="#workshop">Workshop</a>
        <a href="#architecture">How it works</a>
        <a href="#projects">Projects</a>
        <a class="nav-cta" href="#enter">Enter</a>
    </nav>
</header>

<main>
    <section class="hero" id="workshop">
        <div class="hero-copy">
            <p class="eyebrow">AN INDEPENDENT SOFTWARE WORKSHOP</p>
            <h1>Build the pieces.<br /><em>Compose the impossible.</em></h1>
            <p class="hero-lede">
                The Singularity Workshop is where small, independent ideas become
                larger systems—without losing the ability to understand, replace,
                or recombine the pieces.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="#enter">Explore the Workshop <span>↗</span></a>
                <a class="button button-quiet" href="#architecture">See the architecture</a>
            </div>
        </div>

        <div class="workshop-orbit" aria-label="A visual representation of composable systems">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>
            <div class="core">
                <span class="core-mark">[0]</span>
                <span class="core-label">COMPOSE</span>
            </div>
            <span class="node node-a">STATE</span>
            <span class="node node-b">ONTOLOGY</span>
            <span class="node node-c">EXPERIENCE</span>
            <span class="node node-d">AI</span>
        </div>
    </section>

    <section class="manifesto section-rule">
        <div class="section-label">01 / WHY</div>
        <div>
            <h2>Software should be <span>assembled</span>, not entombed.</h2>
            <p>
                The Workshop explores a different way to build software:
                independent capabilities, explicit boundaries, semantic contracts,
                and composition at runtime. A small package should be able to
                become part of something much larger without becoming trapped
                inside it.
            </p>
        </div>
    </section>

    <section class="demo-panel" id="enter">
        <div class="demo-intro">
            <p class="eyebrow">LIVE CONCEPT / 001</p>
            <h2>The Workshop is actually running.</h2>
            <p>
                Start with almost nothing. Add a capability. Give it a meaning.
                Let the composition boundary assemble the experience.
            </p>
        </div>
        <div class="demo-stage">
            <div class="stage-topline">
                <span>EXPERIENCE MANIFEST</span>
                <span class="status"><i></i> READY</span>
            </div>
            <div class="manifest-code">
                <span class="code-muted">{</span>
                <span><b>"runtimeId"</b>: @Runtime.Assembly.RuntimeId</span>
                <span><b>"bundles"</b>: [ @Runtime.Assembly.Bundles.Count ]</span>
                <span><b>"bootstrap"</b>: @Runtime.Moniker.Id</span>
                <span><b>"provider"</b>: "@Runtime.Moniker.Descriptor.Providers[0].Id"</span>
                <span><b>"arbitration"</b>: @Runtime.Assembly.ArbitrationRounds</span>
                <span class="code-muted">}</span>
            </div>
            <div class="runtime-moniker">
                @BlazorGuiRenderer.Render(Runtime.Moniker.Root!)
            </div>
            <div class="stage-result">
                <span class="result-pulse"></span>
                <strong>FSM_COS runtime assembly ready</strong>
                <small>Manifest → MicroBundle → arbitration → Blazor</small>
            </div>
        </div>
    </section>

    <section class="architecture section-rule" id="architecture">
        <div class="section-label">02 / THE IDEA</div>
        <div class="architecture-grid">
            <article>
                <span class="card-number">01</span>
                <h3>Independent pieces</h3>
                <p>Packages stay useful on their own. No giant framework has to own the whole universe.</p>
            </article>
            <article>
                <span class="card-number">02</span>
                <h3>Explicit meaning</h3>
                <p>Protocols, grammar, ontology, and state give systems shared language without hiding the contracts.</p>
            </article>
            <article>
                <span class="card-number">03</span>
                <h3>Runtime composition</h3>
                <p>FSM_COS acts as the composition boundary: gather the pieces, arbitrate them, and seal a runtime.</p>
            </article>
            <article>
                <span class="card-number">04</span>
                <h3>Experiences</h3>
                <p>The result is not merely a library. It can become a tool, a world, a workflow, or something we haven't named yet.</p>
            </article>
        </div>
    </section>

    <section class="projects section-rule" id="projects">
        <div class="section-label">03 / THE WORKBENCH</div>
        <div class="projects-heading">
            <h2>A growing family of <span>small machines.</span></h2>
            <p>Each project has a job. Together they become a workshop.</p>
        </div>
        <div class="project-list">
            <a href="https://github.com/TrentBest/TheSingularityWorkshop.FSM_API" class="project-card">
                <span>FSM_API</span><strong>State as an atomic unit of functionality.</strong><b>↗</b>
            </a>
            <a href="https://github.com/TrentBest/TheSingularityWorkshop.FSM_COS" class="project-card">
                <span>FSM_COS</span><strong>The composition boundary that assembles a runtime.</strong><b>↗</b>
            </a>
            <a href="https://github.com/TrentBest/TheSingularityWorkshop.Ontology" class="project-card">
                <span>ONTOLOGY</span><strong>Semantic structure without forcing one universal worldview.</strong><b>↗</b>
            </a>
            <a href="https://github.com/TrentBest/AnyApp" class="project-card">
                <span>ANYAPP</span><strong>A host for experiences forged from independent pieces.</strong><b>↗</b>
            </a>
        </div>
    </section>

    <section class="closing">
        <div class="closing-glow"></div>
        <p class="eyebrow">THE DOOR IS OPEN</p>
        <h2>Come see what happens<br /><em>when the pieces connect.</em></h2>
        <div class="closing-actions">
            <a class="button button-primary" href="https://github.com/TrentBest">Visit the workshop on GitHub <span>↗</span></a>
            <a class="button button-quiet light" href="https://www.nuget.org/profiles/TheSingularityWorkshop">Browse the packages</a>
        </div>
        <p class="signature">The Singularity Workshop · built in public · one experiment at a time.</p>
    </section>
</main>
